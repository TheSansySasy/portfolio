# Response headers, applied by Cloudflare Workers static assets.
# Not a served file: the platform reads it and keeps it out of the site.

# Everything: basic hardening. No Content-Security-Policy yet; the theme
# script and the JSON-LD block are inline, so a policy needs hashes first.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Vite fingerprints every file under /assets, so a changed file has a new name
# and an old one never changes. Cache them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Stable names that change rarely: a day, so a correction shows up tomorrow.
/runbooks/*
  Cache-Control: public, max-age=86400
/resume/*
  Cache-Control: public, max-age=86400
/og.png
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400

# The design review page stays out of search results (it also says so in its HTML).
/styleguide
  X-Robots-Tag: noindex
