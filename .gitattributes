# Normalize line endings in the repo to LF, regardless of OS
* text=auto eol=lf

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.gif binary
*.pdf binary
*.glb binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.webm binary
