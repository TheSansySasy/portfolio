{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static-only Worker: no server code, just the built site in dist/.
  // Response headers come from public/_headers. See PLAN.md 10.1.
  "name": "portfolio",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // The apex is attached as a custom domain: Cloudflare creates its DNS record
  // and certificate on deploy. This needs sansysasy.com to be an active zone
  // in the same account, so a deploy fails until the nameservers have moved.
  // www is not listed: a redirect rule in the dashboard sends it to the apex.
  "routes": [{ "pattern": "sansysasy.com", "custom_domain": true }],
  // Declaring routes turns these off by default. Keep both: the workers.dev
  // address as a fallback, and a preview URL for every branch.
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  }
}
